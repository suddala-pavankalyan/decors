DATABASE_URL="postgresql://decors:decors@localhost:5432/decors?schema=public"
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="change-me"   # generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys). Use TEST keys (rzp_test_...) in development.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret you set when adding the webhook (Settings -> Webhooks) pointing to <api>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# Uploaded product photos are stored here (local disk). Use S3/Cloudinary in production.
UPLOAD_DIR="uploads"
# Public base URL of this API, used to build absolute image links.
API_PUBLIC_URL="http://localhost:4000"

# Email (password reset + email verification).
# Development: `docker compose up -d` also starts Mailpit; read the emails at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
# Production: your provider's SMTP settings (SendGrid, Amazon SES, Mailgun, Brevo, Gmail app password...)
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"   # "true" for port 465
MAIL_FROM="Decors <no-reply@decors.local>"
# Links in the emails point to WEB_ORIGIN (above), so set it to your real website address in production.
