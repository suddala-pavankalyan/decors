# Same settings as apps/api/.env.example. Copy this file to .env in apps/api-java
# (the Java API reads .env from the folder you start it in; real environment variables win).
DATABASE_URL="postgresql://decors:decors@localhost:5432/decors?schema=public"
WEB_ORIGIN="http://localhost:3000"
# At least 32 characters. generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the same value as apps/api/.env and a login made on one backend keeps working on the other.
JWT_SECRET=""
PORT="4000"

# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys). Use TEST keys (rzp_test_...) in development.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Uploaded product photos are stored here (local disk). Use S3/Cloudinary in production.
UPLOAD_DIR="uploads"
# Public base URL of this API, used to build absolute image links.
API_PUBLIC_URL="http://localhost:4000"

# Email (password reset + email verification). Development: Mailpit from docker compose, inbox at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"   # "true" for port 465
MAIL_FROM="Decors <no-reply@decors.local>"

# Set to "production" on a real server: Secure cookies, and emails are never printed to the log.
APP_ENV="development"
